# Generate actual local secrets with: python scripts/bootstrap.py
# Do not copy predictable passwords into .env.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
LLM_ENABLED=false
LLM_URL=http://127.0.0.1:18080/v1
LLM_MODEL=Qwen3-1.7B-Q4_K_M
LLM_TIMEOUT_SECONDS=120
# A remote endpoint requires HTTPS, LLM_API_KEY and optionally LLM_CA_FILE.
# DATABASE_URL must name an enrolled PostgreSQL database for native execution.
