# ThreatScope repository environment example
# Copy this file to `.env` at the repo root and adjust values for your environment.

# ── Project ────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=threatscope
APP_ENV=development
APP_NAME=ThreatScope

# ── Backend API ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
SECRET_KEY=changeme-super-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_NODE_API_KEY=dev-key

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=threatscope
POSTGRES_PASSWORD=threatscope
POSTGRES_DB=threatscope
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://threatscope:threatscope@postgres:5432/threatscope
SYNC_DATABASE_URL=postgresql://threatscope:threatscope@postgres:5432/threatscope

# ── Cache / Stream / Queue ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NODE_SIGNALS_TOPIC=node_signals
KAFKA_MODEL_UPDATES_TOPIC=model_updates
KAFKA_ALERTS_TOPIC=alerts

# ── Backend Services ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORRELATION_WINDOW_SECONDS=120
ALERT_THRESHOLD_NODES=3
ALERT_THRESHOLD_SCORE=0.80
RATE_LIMIT_PER_MINUTE=60

# ── Node Simulator ─────────────────────────────────────────────────────────
NODE_SIMULATOR_COUNT=5
NODE_SIMULATOR_INTERVAL_SECONDS=5
NODE_WINDOW_SECONDS=60
SIGNAL_SENDER_MODE=http

# ── Observability ──────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Optional ML / Artifact Paths ───────────────────────────────────────────
LOCAL_MODEL_PATH=./node_simulator/models/sample_isolation.joblib
DISTILLED_MODEL_PATH=./models/distilled_model.joblib

# ── External Integrations / Placeholders ───────────────────────────────────
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
