{
  "title": "ThreatScope SOC Dashboard",
  "uid": "threatscope-soc",
  "tags": ["threatscope", "security"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Signals Ingested / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(threatscope_signals_ingested_total[1m])",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alerts Raised (total)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(threatscope_alerts_raised_total)",
          "legendFormat": "Total Alerts"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "threatscope_websocket_connections_active",
          "legendFormat": "SOC Analysts Online"
        }
      ]
    },
    {
      "id": 4,
      "title": "Correlation Engine Latency (p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(threatscope_correlation_latency_seconds_bucket[5m]))",
          "legendFormat": "p99 latency"
        },
        {
          "expr": "histogram_quantile(0.50, rate(threatscope_correlation_latency_seconds_bucket[5m]))",
          "legendFormat": "p50 latency"
        }
      ]
    },
    {
      "id": 5,
      "title": "Alerts by Severity",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (severity) (threatscope_alerts_raised_total)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Nodes",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "threatscope_active_nodes",
          "legendFormat": "Nodes"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
