# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=ThreatScope
APP_ENV=development          # development | production
SECRET_KEY=changeme-generate-a-real-secret-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://threatscope:threatscope@postgres:5432/threatscope
SYNC_DATABASE_URL=postgresql://threatscope:threatscope@postgres:5432/threatscope

# ── Valkey (Redis-compatible) ──────────────────────────────────────────────────
# Valkey is a FOSS BSD-3 drop-in replacement for Redis.
# redis-py connects to Valkey using the same host/port/protocol.
VALKEY_URL=redis://valkey:6379/0

# ── Celery Broker + Backend ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_RESULT_BACKEND=redis://valkey:6379/2

# ── Correlation Engine ────────────────────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=120
ALERT_THRESHOLD_NODES=3
ALERT_THRESHOLD_SCORE=0.80

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Prometheus ────────────────────────────────────────────────────────────────
METRICS_PORT=9100
